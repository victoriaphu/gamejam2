[sub_resource type="GDScript" id="GDScript_qbwt3"]
script/source = "extends Control

@export var main_game_scene: PackedScene

@onready var animation_player: AnimationPlayer = $AnimationPlayer


func _ready() -> void:
	if main_game_scene == null:
		push_error(\"Main Game Scene is empty. Assign your level .tscn in the Inspector.\")
		return

	if not animation_player.has_animation(\"cutscene\"):
		push_error(\"No animation named cutscene was found.\")
		return

	var duration := animation_player.get_animation(\"cutscene\").length
	animation_player.play(\"cutscene\")

	await get_tree().create_timer(duration).timeout
	get_tree().change_scene_to_packed(main_game_scene)
"

